-- ينشئ زر عائم مخفي، مكانه يتحفظ مع الإعدادات
local function CreateFloatingButton(Flag, Text, Callback)
    local gui = EnsureFloatGui()
    local posKey = "__pos_" .. Flag

    local btn = Instance.new("TextButton")
    btn.Name = "Float_" .. Flag
    btn.Size = UDim2.new(0, 90, 0, 36)
    btn.BackgroundColor3 = Color3.fromRGB(12, 12, 14)
    btn.BackgroundTransparency = 0.1
    btn.Text = Text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.AutoButtonColor = false
    btn.Visible = false
    btn.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.4
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Parent = btn

    -- مكان البداية: المحفوظ إذا تحمّلت الإعدادات، غير كذا مكان افتراضي
    local saved = Flags[posKey]
    if Library.ConfigLoaded and type(saved) == "table" then
        btn.Position = UDim2.new(saved.xs, saved.xo, saved.ys, saved.yo)
    else
        btn.Position = UDim2.new(0.5, -45, 0.2 + (FloatCount * 0.1), 0)
    end
    FloatCount = FloatCount + 1

    Setters[posKey] = function(v)
        if type(v) == "table" then
            btn.Position = UDim2.new(v.xs, v.xo, v.ys, v.yo)
        end
    end

    local dragged = false
    MakeDraggable(btn, btn, {
        onBegin = function() dragged = false end,
        onMove = function(dist) dragged = dist > 6 end,
        onEnd = function(pos)
            Flags[posKey] = {
                xs = pos.X.Scale, xo = pos.X.Offset,
                ys = pos.Y.Scale, yo = pos.Y.Offset,
            }
        end,
    })

    btn.MouseButton1Click:Connect(function()
        if dragged then return end
        CreateRipple(btn)
        if Callback then Callback() end
    end)

    return btn
end

