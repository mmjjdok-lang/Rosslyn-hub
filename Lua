local function Clamp01(x) return math.clamp(x, 0, 1) end

local function ApplyStyle(target)
    local st = Flags["__style_" .. target.key]
    if type(st) ~= "table" then return end
    if st.name then target.label.Text = st.name end
    if st.h then target.frame.Size = UDim2.new(1, 0, 0, st.h) end
    if st.t then target.frame.BackgroundTransparency = st.t end
    if st.c and target.stroke then target.stroke.Color = TableToColor(st.c, target.stroke.Color) end
end

