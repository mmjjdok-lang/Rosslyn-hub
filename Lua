-- ================================
-- صفحة الصورة الشخصية (Skin Hub)
-- ================================
local Avatar = {
    original = nil,   -- وصف السكن الأصلي للاعب
    panel = nil,      -- واجهة الصفحة
}

local function GetHumanoid()
    local lp = Players.LocalPlayer
    local c = lp and lp.Character
    return c and c:FindFirstChildOfClass("Humanoid"), c
end

-- يحوّل الاسم أو الـ ID إلى UserId
local function ResolveUserId(text)
    text = string.gsub(tostring(text or ""), "%s", "")
    if text == "" then return nil end
    local n = tonumber(text)
    if n then return math.floor(n) end
    local ok, id = pcall(function() return Players:GetUserIdFromNameAsync(text) end)
    if ok and id then return id end
    return nil
end

local function ApplySkinById(uid)
    local hum = GetHumanoid()
    if not hum then return false, "ما فيه شخصية" end

    if not Avatar.original then
        local okO, d = pcall(function() return hum:GetAppliedDescription() end)
        if okO and d then Avatar.original = d end
    end

    local okD, desc = pcall(function() return Players:GetHumanoidDescriptionFromUserId(uid) end)
    if not okD or not desc then return false, "ما قدرت أجيب سكن هذا اللاعب" end

    local okA, err = pcall(function() hum:ApplyDescription(desc) end)
    if not okA then return false, tostring(err) end
    return true
end

local function ResetSkin()
    local hum = GetHumanoid()
    if not hum or not Avatar.original then
        return false, "ما فيه سكن أصلي محفوظ"
    end
    local ok, err = pcall(function() hum:ApplyDescription(Avatar.original) end)
    if not ok then return false, tostring(err) end
    return true
end

-- إعادة تطبيق السكن تلقائياً عند الظهور
do
    local lp = Players.LocalPlayer
    if lp then
        lp.CharacterAdded:Connect(function()
            Avatar.original = nil
            task.wait(1)
            if Flags.__skin_auto == true and Flags.__skin_uid then
                ApplySkinById(Flags.__skin_uid)
            end
            if Flags.__aura and Flags.__aura_on == true then
                for _, eff in ipairs(Library.Effects) do
                    if eff.Name == Flags.__aura then
                        local _, char = GetHumanoid()
                        ApplyAura(char, eff)
                        break
                    end
                end
            end
        end)
    end
end

-- يبني صفحة الصورة الشخصية ويرجع دالة تفتحها وتسكرها
function Library:CreateAvatarHub()
    if Avatar.panel then return Avatar.panel end

    local sg = Instance.new("ScreenGui")
    sg.Name = "MonoGlassAvatar"
    sg.ResetOnSpawn = false
    sg.DisplayOrder = 500
    sg.Enabled = false
    sg.Parent = ParentGui

    local panel = Instance.new("Frame")
    panel.Size = UDim2.new(0, 320, 0, 360)
    panel.Position = UDim2.new(0.5, -160, 0.5, -180)
    panel.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
    panel.BackgroundTransparency = 0.15
    panel.Parent = sg
    local pc = Instance.new("UICorner")
    pc.CornerRadius = UDim.new(0, 14)
    pc.Parent = panel
    local ps = Instance.new("UIStroke")
    ps.Thickness = 1.6
    ps.Color = Color3.fromRGB(170, 90, 255)
    ps.Parent = panel
    local pg = Instance.new("UIGradient")
    pg.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(170, 90, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 100, 200)),
    })
    pg.Parent = ps

    local top = Instance.new("Frame")
    top.Size = UDim2.new(1, 0, 0, 42)
    top.BackgroundTransparency = 1
    top.Parent = panel
    MakeDraggable(top, panel)

    local ttl = Instance.new("TextLabel")
    ttl.Size = UDim2.new(1, -60, 1, 0)
    ttl.Position = UDim2.new(0, 16, 0, 0)
    ttl.BackgroundTransparency = 1
    StyleText(ttl, "Skin Hub", 15, Enum.Font.GothamBold, Color3.fromRGB(255, 255, 255))
    ttl.TextXAlignment = Enum.TextXAlignment.Left
    ttl.Parent = top

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -38, 0, 6)
    closeBtn.BackgroundTransparency = 1
    closeBtn.AutoButtonColor = false
    closeBtn.Text = "X"
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 14
    closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeBtn.Parent = top
    closeBtn.MouseButton1Click:Connect(function() sg.Enabled = false end)

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1, -16, 1, -50)
    scroll.Position = UDim2.new(0, 8, 0, 46)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 2
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.Parent = panel
    local sl = Instance.new("UIListLayout")
    sl.Padding = UDim.new(0, 8)
    sl.SortOrder = Enum.SortOrder.LayoutOrder
    sl.Parent = scroll

    local E = MakeElements(function() return scroll end, {})

    E:AddTextBox("اسم اللاعب أو الـ ID", "مثال: Roblox أو 1", nil, "__skin_input")

    E:AddButton("تطبيق السكن", function()
        local uid = ResolveUserId(Flags.__skin_input)
        if not uid then
            Library:Notify({ Title = "Skin", Message = "الاسم أو الـ ID غلط", Duration = 3 })
            return
        end
        local ok, err = ApplySkinById(uid)
        if ok then
            Flags.__skin_uid = uid
            ScheduleSave()
            Library:Notify({ Title = "Skin", Message = "تم تطبيق السكن", Duration = 3 })
        else
            Library:Notify({ Title = "Skin", Message = tostring(err), Duration = 4 })
        end
    end)

    E:AddButton("إعادة تعيين السكن", function()
        local ok, err = ResetSkin()
        Library:Notify({ Title = "Skin", Message = ok and "رجع السكن الأصلي" or tostring(err), Duration = 3 })
    end)

    E:AddToggle("إعادة التطبيق عند الظهور", nil, nil, "__skin_auto")

    local effectNames = {}
    for _, eff in ipairs(Library.Effects) do
        table.insert(effectNames, eff.Name)
    end
    E:AddDropdown("الهالة", effectNames, nil, function(name)
        Flags.__aura = name
    end, "__aura")

    E:AddToggle("تفعيل الهالة", nil, function(on)
        local _, char = GetHumanoid()
        if not on then
            ClearAura(char)
            return
        end
        for _, eff in ipairs(Library.Effects) do
            if eff.Name == Flags.__aura then
                ApplyAura(char, eff)
                return
            end
        end
    end, "__aura_on")

    Avatar.panel = sg
    return sg
end

-- يضيف زر Skin Hub لأي تبويب
function Library:AddAvatarButton(Elements)
    return Elements:AddButton("Skin Hub", function()
        local sg = Library:CreateAvatarHub()
        sg.Enabled = not sg.Enabled
    end)
end

return Library
