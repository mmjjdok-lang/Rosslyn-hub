local function ApplyAura(char, eff)
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local old = root:FindFirstChild("MonoGlassAura")
    if old then old:Destroy() end
    local pe = Instance.new("ParticleEmitter")
    pe.Name = "MonoGlassAura"
    pe.Texture = eff.Texture
    pe.Color = ColorSequence.new(eff.Color)
    pe.Rate = eff.Rate
    pe.Speed = NumberRange.new(eff.Speed)
    pe.Lifetime = NumberRange.new(eff.Lifetime)
    pe.Size = NumberSequence.new(eff.Size)
    pe.LightEmission = 0.6
    pe.Parent = root
    return true
end

local function ClearAura(char)
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        local old = root:FindFirstChild("MonoGlassAura")
        if old then old:Destroy() end
    end
end

