            VLbl.BackgroundTransparency = 1
            VLbl.Text = tostring(Value)
            VLbl.Font = Enum.Font.GothamBold
            VLbl.TextSize = 12
            VLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
            VLbl.TextXAlignment = Enum.TextXAlignment.Right
            VLbl.Parent = SFrame

            local BarBg = Instance.new("Frame")
            BarBg.Size = UDim2.new(1, -20, 0, 5)
            BarBg.Position = UDim2.new(0, 10, 0, 32)
            BarBg.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
            BarBg.BorderSizePixel = 0
            BarBg.Parent = SFrame

            local BC = Instance.new("UICorner")
            BC.CornerRadius = UDim.new(1, 0)
            BC.Parent = BarBg

            local BarFill = Instance.new("Frame")
            BarFill.Size = UDim2.new((Value - Min) / (Max - Min), 0, 1, 0)
            BarFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            BarFill.BorderSizePixel = 0
            BarFill.Parent = BarBg

            local BFC = Instance.new("UICorner")
            BFC.CornerRadius = UDim.new(1, 0)
            BFC.Parent = BarFill

            local function Update(input)
                local pos = UDim2.new(math.clamp((input.Position.X - BarBg.AbsolutePosition.X) / BarBg.AbsoluteSize.X, 0, 1), 0, 1, 0)
                BarFill.Size = pos
                Value = math.floor(Min + ((Max - Min) * pos.X.Scale))
                VLbl.Text = tostring(Value)
                if Callback then Callback(Value) end
            end

            local dragging = false
            BarBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    Update(input)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    Update(input)
                end
            end)
        end

        return Elements
    end

    return WindowFuncs
end

