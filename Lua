local IconModule = nil
do
    local ok, mod = pcall(function()
        local src = game:HttpGet("https://raw.githubusercontent.com/Footagesus/Icons/main/Main-v2.lua")
        local loader = loadstring or load
        return loader(src)()
    end)
    if ok and type(mod) == "table" and mod.Icon then
        IconModule = mod
    else
        warn("[MonoGlassUI] فشل تحميل الأيقونات")
    end
end

local function GetIcon(iconName)
    if IconModule and iconName then
        local ok, data = pcall(function() return IconModule.Icon(iconName, "lucide") end)
        if ok and data then
            if type(data) == "string" then return { Image = data } end
            if type(data) == "table" and data[1] then
                local info = data[2] or {}
                return { Image = data[1], RectSize = info.ImageRectSize, RectOffset = info.ImageRectPosition }
            end
        end
    end
    return nil
end

local function ApplyIcon(img, iconData)
    img.Image = iconData.Image
    if iconData.RectSize then
        img.ImageRectSize = iconData.RectSize
        img.ImageRectOffset = iconData.RectOffset or Vector2.new(0, 0)
    end
end

