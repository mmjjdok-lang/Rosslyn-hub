    -- ===== توجل (يحفظ حالته) =====
    function E:AddToggle(Text, _Default, Callback, Flag, Opts)
        Flag = Flag or Text
        local State = false
        if Library.ConfigLoaded and Flags[Flag] ~= nil then
            State = Flags[Flag] == true
        end
        Flags[Flag] = State

        local row, click = MakeRow(ctx, P, Text, "tgl_" .. Flag, Opts)

        local sw = Instance.new("Frame")
        sw.Size = UDim2.new(0, 40, 0, 20)
        sw.Position = UDim2.new(1, -50, 0.5, -10)
        sw.Parent = row
        local swc = Instance.new("UICorner")
        swc.CornerRadius = UDim.new(1, 0)
        swc.Parent = sw

        local knob = Instance.new("Frame")
        knob.Size = UDim2.new(0, 14, 0, 14)
        knob.Parent = sw
        local kc = Instance.new("UICorner")
        kc.CornerRadius = UDim.new(1, 0)
        kc.Parent = knob

        local function Visual(v, animate)
            local t = animate and 0.2 or 0
            TweenService:Create(sw, TweenInfo.new(t), {
                BackgroundColor3 = v and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(35, 35, 40)
            }):Play()
            TweenService:Create(knob, TweenInfo.new(t, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Position = v and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
                BackgroundColor3 = v and Color3.fromRGB(10, 10, 12) or Color3.fromRGB(200, 200, 200)
            }):Play()
        end
        Visual(State, false)

        Setters[Flag] = function(v)
            State = v == true
            Flags[Flag] = State
            Visual(State, true)
            if Callback then Callback(State) end
        end

        click.MouseButton1Click:Connect(function()
            CreateRipple(row)
            State = not State
            Flags[Flag] = State
            Visual(State, true)
            ScheduleSave()
            if Callback then Callback(State) end
        end)

        return row
    end

    -- ===== توجل يشغّل زر عائم =====
    function E:AddFloatingToggle(Text, Callback, Flag)
        Flag = Flag or Text
        local floatBtn = BuildFloat(Flag, Text, Callback)
        E:AddToggle(Text, nil, function(state)
            floatBtn.Visible = state
        end, Flag)
        floatBtn.Visible = Flags[Flag] == true
        return floatBtn
    end

    -- ===== سلايدر (مع خيار دمج توجل) =====
    -- Opts.WithToggle = true يضيف مربع تفعيل يمين/يسار العنوان
    function E:AddSlider(Text, Min, Max, Default, Callback, Flag, Opts)
        Flag = Flag or Text
        Min = Min or 0
        Max = Max or 100
        local Value = Default or Min
        if Library.ConfigLoaded and Flags[Flag] ~= nil then
            Value = Flags[Flag]
        end

        local frame = Card("Frame", P(), 52)
        local enabled = true
        local enabledKey = Flag .. "__enabled"
        local tgl = nil

        if Opts and Opts.WithToggle then
            if Library.ConfigLoaded and Flags[enabledKey] ~= nil then
                enabled = Flags[enabledKey] == true
            end
            Flags[enabledKey] = enabled

            tgl = Instance.new("TextButton")
            tgl.Size = UDim2.new(0, 22, 0, 16)
            tgl.Position = UDim2.new(0, 10, 0, 6)
            tgl.AutoButtonColor = false
            tgl.Text = ""
            tgl.ZIndex = 2
            tgl.Parent = frame
            local tc = Instance.new("UICorner")
            tc.CornerRadius = UDim.new(0, 5)
            tc.Parent = tgl

            local function Paint()
                tgl.BackgroundColor3 = enabled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(35, 35, 40)
            end
            Paint()
            tgl.MouseButton1Click:Connect(function()
                enabled = not enabled
                Flags[enabledKey] = enabled
                Paint()
                ScheduleSave()
            end)
        end

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -90, 0, 22)
        lbl.Position = UDim2.new(0, tgl and 40 or 10, 0, 4)
        lbl.BackgroundTransparency = 1
        StyleText(lbl, Text, 13, Enum.Font.GothamMedium, Color3.fromRGB(245, 245, 245))
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = frame

        local valLbl = Instance.new("TextLabel")
        valLbl.Size = UDim2.new(0, 60, 0, 22)
        valLbl.Position = UDim2.new(1, -70, 0, 4)
        valLbl.BackgroundTransparency = 1
        StyleText(valLbl, "", 13, Enum.Font.GothamBold, Color3.fromRGB(255, 255, 255))
        valLbl.TextXAlignment = Enum.TextXAlignment.Right
        valLbl.Parent = frame

        local bar = Instance.new("Frame")
        bar.Size = UDim2.new(1, -20, 0, 6)
        bar.Position = UDim2.new(0, 10, 0, 34)
        bar.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
        bar.BorderSizePixel = 0
        bar.Active = true
        bar.Parent = frame
        local bc = Instance.new("UICorner")
        bc.CornerRadius = UDim.new(1, 0)
        bc.Parent = bar

        local fill = Instance.new("Frame")
        fill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        fill.BorderSizePixel = 0
        fill.Parent = bar
        local fc = Instance.new("UICorner")
        fc.CornerRadius = UDim.new(1, 0)
        fc.Parent = fill

        local function SetValue(v)
            v = math.clamp(tonumber(v) or Min, Min, Max)
            Value = v
            Flags[Flag] = v
            fill.Size = UDim2.new((v - Min) / (Max - Min), 0, 1, 0)
            valLbl.Text = tostring(v)
        end
        SetValue(Value)

        local function Fire()
            if Callback and (tgl == nil or enabled) then Callback(Value) end
        end

        Setters[Flag] = function(v)
            SetValue(v)
            Fire()
        end

        local function Update(input)
            local rel = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            SetValue(math.floor(Min + (Max - Min) * rel))
            ScheduleSave()
            Fire()
        end

        local dragging = false
        bar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                Update(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                Update(input)
            end
        end)

        return frame
    end

