local function EnsureFolders()
    if not makefolder then return false end
    if not (isfolder and isfolder(FolderName)) then
        pcall(makefolder, FolderName)
    end
    if not (isfolder and isfolder(ConfigFolder)) then
        pcall(makefolder, ConfigFolder)
    end
    return true
end

-- حفظ الإعدادات داخل: MonoGlassUI/Configs/<name>.json
-- يتحقق من الكتابة بقراءة الملف مرة ثانية قبل ما يقول "تم"
function Library:SaveConfig(name)
    name = name or "default"
    if not writefile then
        Library:Notify({ Title = "Config", Message = "الـ executor لا يدعم الحفظ", Duration = 4 })
        return false, "no writefile"
    end

    EnsureFolders()
    local path = ConfigFolder .. "/" .. name .. ".json"

    local okEncode, json = pcall(function()
        return HttpService:JSONEncode(Flags)
    end)
    if not okEncode then
        Library:Notify({ Title = "Config", Message = "فشل تجهيز البيانات", Duration = 4 })
        return false, json
    end

    local okWrite, errWrite = pcall(writefile, path, json)
    if not okWrite then
        Library:Notify({ Title = "Config", Message = "فشل الكتابة: " .. tostring(errWrite), Duration = 4 })
        return false, errWrite
    end

    -- تحقق فعلي: هل الملف موجود ومحتواه صح؟
    local verified = false
    if isfile and isfile(path) and readfile then
        local okRead, content = pcall(readfile, path)
        verified = okRead and content == json
    else
        verified = true -- executor ما يدعم التحقق، نعتبر الكتابة نجحت
    end

    if verified then
        Library:Notify({ Title = "Config", Message = "تم حفظ الإعدادات: " .. name, Duration = 3 })
    else
        Library:Notify({ Title = "Config", Message = "الحفظ ما تأكد من الملف", Duration = 4 })
    end
    return verified, path
end

-- تحميل الإعدادات وتطبيقها (تنفع قبل أو بعد إنشاء العناصر)
function Library:LoadConfig(name)
    name = name or "default"
    if not (readfile and isfile) then
        Library:Notify({ Title = "Config", Message = "الـ executor لا يدعم التحميل", Duration = 4 })
        return false, "no readfile"
    end

    local path = ConfigFolder .. "/" .. name .. ".json"
    if not isfile(path) then
        Library:Notify({ Title = "Config", Message = "ما لقيت: " .. name, Duration = 3 })
        return false, "not found"
    end

    local okRead, content = pcall(readfile, path)
    if not okRead then
        return false, content
    end

    local okDecode, data = pcall(function()
        return HttpService:JSONDecode(content)
    end)
    if not okDecode or type(data) ~= "table" then
        Library:Notify({ Title = "Config", Message = "ملف الإعدادات تالف", Duration = 4 })
        return false, "bad json"
    end

    for flag, value in pairs(data) do
        Flags[flag] = value
    end
    Library.ConfigLoaded = true

    -- تطبيق القيم على العناصر الموجودة حالياً
    for flag, value in pairs(data) do
        if Setters[flag] then
            pcall(Setters[flag], value)
        end
    end

    Library:Notify({ Title = "Config", Message = "تم تحميل: " .. name, Duration = 3 })
    return true
end

-- قائمة أسماء الإعدادات المحفوظة
function Library:ListConfigs()
    local list = {}
    if listfiles and isfolder and isfolder(ConfigFolder) then
        for _, path in ipairs(listfiles(ConfigFolder)) do
            local n = path:match("([^/\\]+)%.json$")
            if n then table.insert(list, n) end
        end
    end
    return list
end

