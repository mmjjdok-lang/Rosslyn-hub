        -- عنصر Slider مكتبي
        function Elements:AddSlider(Text, Min, Max, Default, Callback)
            local Value = Default or Min
            local SFrame = Instance.new("Frame")
            SFrame.Size = UDim2.new(1, 0, 0, 48)
            SFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
