-- يرجع بيانات الأيقونة، أو nil إذا ما لقاها (بدون أيقونة احتياطية)
local function GetIcon(iconName)
    if IconModule and iconName then
        local ok, data = pcall(function()
            return IconModule.Icon(iconName, "lucide")
        end)

        if ok and data then
            if type(data) == "string" then
                return { Image = data }
            elseif type(data) == "table" and data[1] then
                local info = data[2] or {}
                return {
                    Image = data[1],
                    RectSize = info.ImageRectSize,
                    RectOffset = info.ImageRectPosition,
                }
            end
        end
    end
    return nil
end

