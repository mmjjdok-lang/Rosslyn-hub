-- محرر مصغّر: الاسم، الارتفاع، الشفافية، لون الحد
local function OpenMini(ctx, title, target)
    if not ctx.overlay then return end
    local content, close = ctx.overlay("تعديل: " .. tostring(title))

    local lay = Instance.new("UIListLayout")
    lay.Padding = UDim.new(0, 8)
    lay.SortOrder = Enum.SortOrder.LayoutOrder
    lay.Parent = content

    local function Save(patch)
        local st = Flags["__style_" .. target.key]
        if type(st) ~= "table" then st = {} end
        for k, v in pairs(patch) do st[k] = v end
        Flags["__style_" .. target.key] = st
        ApplyStyle(target)
        ScheduleSave()
    end

    Field(content, "الاسم", target.label.Text, function(t)
        if t ~= "" then Save({ name = t }) end
    end)
    Field(content, "الارتفاع (24-120)", math.floor(target.frame.AbsoluteSize.Y), function(t)
        local n = tonumber(t)
        if n then Save({ h = math.clamp(n, 24, 120) }) end
    end)
    Field(content, "الشفافية (0-1)", 0.92, function(t)
        local n = tonumber(t)
        if n then Save({ t = Clamp01(n) }) end
    end)

    local pal = Card("Frame", content, 40)
    local pl = Instance.new("UIListLayout")
    pl.FillDirection = Enum.FillDirection.Horizontal
    pl.HorizontalAlignment = Enum.HorizontalAlignment.Center
    pl.VerticalAlignment = Enum.VerticalAlignment.Center
    pl.Padding = UDim.new(0, 6)
    pl.Parent = pal
    for _, col in ipairs(PALETTE) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0, 26, 0, 26)
        b.BackgroundColor3 = col
        b.AutoButtonColor = false
        b.Text = ""
        b.Parent = pal
        local bc = Instance.new("UICorner")
        bc.CornerRadius = UDim.new(1, 0)
        bc.Parent = b
        b.MouseButton1Click:Connect(function()
            Save({ c = ColorToTable(col) })
        end)
    end

    local done = Card("TextButton", content, 34)
    done.Text = "  حفظ وإغلاق"
    done.MouseButton1Click:Connect(function()
        CreateRipple(done)
        close()
    end)
end

