local function EnsureFolders()
    if not makefolder then return end
    if not (isfolder and isfolder(FolderName)) then pcall(makefolder, FolderName) end
    if not (isfolder and isfolder(ConfigFolder)) then pcall(makefolder, ConfigFolder) end
end

function Library:SaveConfig(name, silent)
    name = name or AUTO_NAME
    local function Say(o) if not silent then Library:Notify(o) end end

    if not writefile then
        Say({ Title = "Config", Message = "الـ executor لا يدعم الحفظ", Duration = 4 })
        return false
    end

    EnsureFolders()
    local path = ConfigFolder .. "/" .. name .. ".json"

    local okE, json = pcall(function() return HttpService:JSONEncode(Flags) end)
    if not okE then
        Say({ Title = "Config", Message = "فشل تجهيز البيانات", Duration = 4 })
        return false
    end

    local okW, errW = pcall(writefile, path, json)
    if not okW then
        Say({ Title = "Config", Message = "فشل الكتابة: " .. tostring(errW), Duration = 4 })
        return false
    end

    local verified = true
    if isfile and readfile and isfile(path) then
        local okR, content = pcall(readfile, path)
        verified = okR and content == json
    end

    if verified then
        Say({ Title = "Config", Message = "تم حفظ الإعدادات", Duration = 2 })
    else
        Say({ Title = "Config", Message = "الحفظ ما تأكد من الملف", Duration = 4 })
    end
    return verified
end

function Library:LoadConfig(name, silent)
    name = name or AUTO_NAME
    local function Say(o) if not silent then Library:Notify(o) end end

    if not (readfile and isfile) then return false end
    local path = ConfigFolder .. "/" .. name .. ".json"
    if not isfile(path) then return false end

    local okR, content = pcall(readfile, path)
    if not okR then return false end

    local okD, data = pcall(function() return HttpService:JSONDecode(content) end)
    if not okD or type(data) ~= "table" then
        Say({ Title = "Config", Message = "ملف الإعدادات تالف", Duration = 4 })
        return false
    end

    for flag, value in pairs(data) do
        Flags[flag] = value
    end
    Library.ConfigLoaded = true

    for flag, value in pairs(data) do
        if Setters[flag] then pcall(Setters[flag], value) end
    end

    Say({ Title = "Config", Message = "تم تحميل: " .. name, Duration = 2 })
    return true
end

function Library:ListConfigs()
    local list = {}
    if listfiles and isfolder and isfolder(ConfigFolder) then
        for _, path in ipairs(listfiles(ConfigFolder)) do
            local n = path:match("([^/\\]+)%.json$")
            if n then table.insert(list, n) end
        end
    end
    return list
end

local saveToken = 0
local function ScheduleSave()
    saveToken = saveToken + 1
    local my = saveToken
    task.delay(0.5, function()
        if my == saveToken then Library:SaveConfig(AUTO_NAME, true) end
    end)
end

